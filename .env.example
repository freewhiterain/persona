# Copy to .env and adjust.  Read by persona/config.py.

# --- LLM: any OpenAI-compatible endpoint ------------------------------------
# Local Ollama (default):
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
#
# Cloud examples (swap both lines):
#   OpenAI     -> https://api.openai.com/v1
#   DeepSeek   -> https://api.deepseek.com/v1
#   Doubao/Ark -> https://ark.cn-beijing.volces.com/api/v3

# --- Embeddings (optional) -------------------------------------------------
# Unset -> reuse OPENAI_* above (correct for Ollama, which serves both).
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# --- Offline mode --------------------------------------------------------------
# 1 = never touch the network: LLM returns canned stubs, embedder forced to hash.
#     Use for the test suite or a no-Ollama smoke run.
# 0 = use the real endpoint above.
PERSONA_FAKE_LLM=0
